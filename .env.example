# ─────────────────────────────────────────────────────────────────────────────
# RAG Course — Environment Variables
# Copy this file to .env and fill in your keys
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: LangSmith tracing (Module 8 & 10) ──────────────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=RAG-Course

# ── Optional: Cohere re-ranking (Module 6.5) ─────────────────────────────────
COHERE_API_KEY=...

# ── Optional: Tavily web search (Module 7.3 Corrective RAG) ──────────────────
TAVILY_API_KEY=tvly-...

# ── Optional: Pinecone (Module 4 Vector Stores) ───────────────────────────────
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=us-east-1

# ── Optional: Neo4j (Module 7.5 Graph RAG) ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
